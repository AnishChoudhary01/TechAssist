# Ollama server configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
# 1.5B is the default for 8GB RAM laptops. Use codellama:7b only on machines with more memory.
OLLAMA_TIMEOUT_SECONDS=120
# Keep local CPU generation responsive while allowing a useful troubleshooting answer.
OLLAMA_NUM_PREDICT=256
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Service addresses. These defaults run the three services directly on your machine.
RAG_SERVICE_URL=http://127.0.0.1:8001
LLM_SERVICE_URL=http://127.0.0.1:8002

# RAG storage and retrieval configuration
CHROMA_PERSIST_DIRECTORY=./chroma_data
KNOWLEDGE_BASE_DIRECTORY=./data/knowledge_base
RAG_COLLECTION_NAME=techassist_knowledge
RAG_TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
